  {:el :contained-in :id :sbom-tool.code.adapter.vulnerability/osv-contained-in-vulnerability
   :from :sbom-tool.code.adapter.vulnerability/osv :to :sbom-tool.code.adapter/vulnerability}
  {:el :contained-in :id :sbom-tool.code.adapter.vulnerability/deps-dev-contained-in-vulnerability
