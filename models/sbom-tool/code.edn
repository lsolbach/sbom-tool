;;;;
;;;; Code Model for SBOM Tool
;;;;
#{;
  ; packages and namespaces, mirroring src/sbom_tool

  {:el :package
   :id :sbom-tool.code/domain
   :name "sbom-tool.domain"
   :desc "Pure domain logic: the canonical SBOM model, licenses, vulnerabilities, VEX, purls and CVSS. Depends on nothing else in the project."}

  {:el :package
   :id :sbom-tool.code/application
   :name "sbom-tool.application"
   :desc "Orchestrates domain logic into use cases: the consolidated-component repository, report generation and template rendering."}

  {:el :package
   :id :sbom-tool.code/adapter
   :name "sbom-tool.adapter"
   :desc "Adapters for SBOM, license and VEX formats, vulnerability databases, policy files, report rendering and the CLI."}

  {:el :package
   :id :sbom-tool.code.adapter/sbom
   :name "sbom-tool.adapter.sbom"
   :desc "SBOM format adapters."}

  {:el :package
   :id :sbom-tool.code.adapter/license
   :name "sbom-tool.adapter.license"
   :desc "License data adapters."}

  {:el :package
   :id :sbom-tool.code.adapter/vulnerability
   :name "sbom-tool.adapter.vulnerability"
   :desc "Optional, opt-in live vulnerability database adapters, keyed by purl."}

  {:el :package
   :id :sbom-tool.code.adapter/vex
   :name "sbom-tool.adapter.vex"
   :desc "VEX format adapters."}

  {:el :package
   :id :sbom-tool.code.adapter/report
   :name "sbom-tool.adapter.report"
   :desc "Report rendering adapters."}

  {:el :package
   :id :sbom-tool.code.adapter/ui
   :name "sbom-tool.adapter.ui"
   :desc "Command-line interface."}

  {:el :namespace
   :id :sbom-tool.code.domain/sbom
   :name "sbom-tool.domain.sbom"
   :desc "Canonical SBOM model shared by all adapters and the application layer."}
  {:el :namespace
   :id :sbom-tool.code.domain/component
   :name "sbom-tool.domain.component"
   :desc "Recognizes and merges components describing the same real-world package across different SBOM documents."}
  {:el :namespace
   :id :sbom-tool.code.domain/license
   :name "sbom-tool.domain.license"
   :desc "Evaluates and classifies component licenses against a compliance policy."}
  {:el :namespace
   :id :sbom-tool.code.domain/vulnerability
   :name "sbom-tool.domain.vulnerability"
   :desc "Evaluates and classifies component vulnerabilities against a compliance policy."}
  {:el :namespace
   :id :sbom-tool.code.domain/vex
   :name "sbom-tool.domain.vex"
   :desc "Domain logic for VEX statements: a supplier's per-product assertion of vulnerability exploitability."}
  {:el :namespace
   :id :sbom-tool.code.domain/purl
   :name "sbom-tool.domain.purl"
   :desc "Parses and renders purls (Package URLs)."}
  {:el :namespace
   :id :sbom-tool.code.domain/cvss
   :name "sbom-tool.domain.cvss"
   :desc "Parses CVSS v2/v3 Base vector strings into severity scores and ratings."}

  {:el :namespace
   :id :sbom-tool.code.application/repository
   :name "sbom-tool.application.repository"
   :desc "Holds consolidated components and policy/vulnerability/VEX state read by adapters."}
  {:el :namespace
   :id :sbom-tool.code.application/report
   :name "sbom-tool.application.report"
   :desc "Builds the license, copyright and vulnerability reports from the repository."}
  {:el :namespace
   :id :sbom-tool.code.application/template
   :name "sbom-tool.application.template"
   :desc "Extension point for rendering a report's data in an output format."}

  {:el :namespace
   :id :sbom-tool.code.adapter/policies
   :name "sbom-tool.adapter.policies"
   :desc "Reads and validates license/vulnerability policy files."}

  {:el :namespace
   :id :sbom-tool.code.adapter.sbom/cdx
   :name "sbom-tool.adapter.sbom.cdx"
   :desc "Reads CycloneDX SBOM files into the canonical SBOM model."}
  {:el :namespace
   :id :sbom-tool.code.adapter.sbom/spdx
   :name "sbom-tool.adapter.sbom.spdx"
   :desc "Reads SPDX SBOM files into the canonical SBOM model."}

  {:el :namespace
   :id :sbom-tool.code.adapter.license/spdx
   :name "sbom-tool.adapter.license.spdx"
   :desc "Reads the official SPDX license list to enrich license report entries with their canonical name."}

  {:el :namespace
   :id :sbom-tool.code.adapter.vulnerability/osv
   :name "sbom-tool.adapter.vulnerability.osv"
   :desc "Looks up vulnerabilities in Google OSV."}
  {:el :namespace
   :id :sbom-tool.code.adapter.vulnerability/deps-dev
   :name "sbom-tool.adapter.vulnerability.deps-dev"
   :desc "Looks up vulnerabilities in Google deps.dev."}
  {:el :namespace
   :id :sbom-tool.code.adapter.vulnerability/github-advisory
   :name "sbom-tool.adapter.vulnerability.github-advisory"
   :desc "Looks up vulnerabilities in GitHub's Advisory Database."}

  {:el :namespace
   :id :sbom-tool.code.adapter.vex/openvex
   :name "sbom-tool.adapter.vex.openvex"
   :desc "Reads OpenVEX documents into the canonical VEX model."}

  {:el :namespace
   :id :sbom-tool.code.adapter.report/markdown
   :name "sbom-tool.adapter.report.markdown"
   :desc "Renders reports as markdown."}
  {:el :namespace
   :id :sbom-tool.code.adapter.report/json
   :name "sbom-tool.adapter.report.json"
   :desc "Renders reports as JSON."}

  {:el :namespace
   :id :sbom-tool.code.adapter.ui/cli
   :name "sbom-tool.adapter.ui.cli"
   :desc "Command-line interface: wires adapters to the application layer and renders output. The composition root."}
  {:el :namespace
   :id :sbom-tool.code.adapter.ui/errors
   :name "sbom-tool.adapter.ui.errors"
   :desc "Formats exceptions into short, human-readable CLI messages."}

  ; containment

  {:el :contained-in :id :sbom-tool.code.adapter/sbom-contained-in-adapter
   :from :sbom-tool.code.adapter/sbom :to :sbom-tool.code/adapter}
