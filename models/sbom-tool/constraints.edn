;;;;
;;;; Architecture Constraints for the SBOM Tool (arc42 section 1.3)
;;;;
#{{:el :constraint
   :id :sbom-tool.constraint/namespace-prefix-convention
   :name "sbom-tool namespace prefix"
   :desc "Every project namespace is prefixed with `sbom-tool`."}

  {:el :constraint
   :id :sbom-tool.constraint/mandated-input-standards
   :name "mandated input standards"
   :desc "CycloneDX 1.6 and SPDX 2.2 are the mandated baseline SBOM formats/versions the tool must support, independent of which further formats are added."}

  {:el :constraint
   :id :sbom-tool.constraint/epl-license
   :name "Eclipse Public License 1.0"
   :desc "The project is licensed under the Eclipse Public License 1.0 (EPL-1.0, see LICENSE); included dependencies must be compatible with it."}

  {:el :constraint-for
   :id :sbom-tool.constraint/namespace-prefix-convention-constraint-for-sbom-tool
   :from :sbom-tool.constraint/namespace-prefix-convention
   :to :sbom-tool/sbom-tool}

  {:el :constraint-for
   :id :sbom-tool.constraint/mandated-input-standards-constraint-for-sbom-tool
   :from :sbom-tool.constraint/mandated-input-standards
   :to :sbom-tool/sbom-tool}

  {:el :constraint-for
   :id :sbom-tool.constraint/epl-license-constraint-for-sbom-tool
   :from :sbom-tool.constraint/epl-license
   :to :sbom-tool/sbom-tool}
  ;
  }
