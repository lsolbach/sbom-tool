;;;;
;;;; Architecture Model for the SBOM Tool
;;;;
#{{:el :system
   :id :sbom-tool/sbom-tool
   :name "SBOM Tool"
   :desc "Reads CycloneDX and SPDX software bill of materials files and reports on license and vulnerability compliance."
   :ct #{{:el :container
          :id :sbom-tool/cli
          :name "SBOM Tool CLI"
          :desc "Command-line application that reads SBOM files and reports license and vulnerability compliance."
          :tech "Clojure"}}}

  {:el :person
   :id :sbom-tool/user
   :name "User"
   :desc "Runs the SBOM Tool CLI to check license and vulnerability compliance of software components."}

  {:el :system
   :id :sbom-tool/ci-pipeline
   :external true
   :name "CI/CD Pipeline"
   :desc "Automated pipeline that invokes the SBOM Tool to gate builds on compliance policy violations."}

  {:el :system
   :id :sbom-tool/osv
   :external true
   :name "OSV"
   :desc "Google's open source vulnerability database (osv.dev), queried by purl."}

  {:el :system
   :id :sbom-tool/deps-dev
   :external true
   :name "deps.dev"
   :desc "Google's open source insights service (deps.dev), queried by purl for vulnerability data."}

  {:el :system
   :id :sbom-tool/github-advisory
   :external true
   :name "GitHub Advisory Database"
   :desc "GitHub's advisory database, queried through the GitHub REST API."}

  {:el :request
   :id :sbom-tool/sbom-tool-requests-osv
   :from :sbom-tool/sbom-tool
   :to :sbom-tool/osv
   :name "Looks up vulnerabilities (opt-in)"
   :tech "HTTPS/JSON"}

  {:el :request
   :id :sbom-tool/sbom-tool-requests-deps-dev
   :from :sbom-tool/sbom-tool
   :to :sbom-tool/deps-dev
   :name "Looks up vulnerabilities (opt-in)"
   :tech "HTTPS/JSON"}

  {:el :request
   :id :sbom-tool/sbom-tool-requests-github-advisory
   :from :sbom-tool/sbom-tool
   :to :sbom-tool/github-advisory
   :name "Looks up vulnerabilities (opt-in)"
   :tech "HTTPS/JSON"}

  {:el :request
   :id :sbom-tool/cli-requests-osv
   :from :sbom-tool/cli
   :to :sbom-tool/osv
   :name "Looks up vulnerabilities (opt-in)"
   :tech "HTTPS/JSON"}

  {:el :request
   :id :sbom-tool/cli-requests-deps-dev
   :from :sbom-tool/cli
   :to :sbom-tool/deps-dev
   :name "Looks up vulnerabilities (opt-in)"
   :tech "HTTPS/JSON"}

  {:el :request
   :id :sbom-tool/cli-requests-github-advisory
   :from :sbom-tool/cli
   :to :sbom-tool/github-advisory
   :name "Looks up vulnerabilities (opt-in)"
   :tech "HTTPS/JSON"}

  {:el :uses
   :id :sbom-tool/user-uses-generate-license-report
   :from :sbom-tool/user
   :to :sbom-tool.usecase/generate-license-report}

  {:el :uses
   :id :sbom-tool/user-uses-generate-copyright-report
   :from :sbom-tool/user
   :to :sbom-tool.usecase/generate-copyright-report}

  {:el :uses
   :id :sbom-tool/user-uses-generate-vulnerability-report
   :from :sbom-tool/user
   :to :sbom-tool.usecase/generate-vulnerability-report}

  {:el :uses
   :id :sbom-tool/user-uses-define-compliance-policy
   :from :sbom-tool/user
   :to :sbom-tool.usecase/define-compliance-policy}

  {:el :uses
   :id :sbom-tool/user-uses-enforce-policy-gate
   :from :sbom-tool/user
   :to :sbom-tool.usecase/enforce-policy-gate}

  {:el :uses
   :id :sbom-tool/ci-pipeline-uses-enforce-policy-gate
   :from :sbom-tool/ci-pipeline
   :to :sbom-tool.usecase/enforce-policy-gate}

  {:el :request
   :id :sbom-tool/user-runs-sbom-tool
   :from :sbom-tool/user
   :to :sbom-tool/sbom-tool
   :name "Runs"
   :tech "CLI"}

  {:el :request
   :id :sbom-tool/ci-pipeline-invokes-sbom-tool
   :from :sbom-tool/ci-pipeline
   :to :sbom-tool/sbom-tool
   :name "Invokes"
   :tech "CLI"}

  {:el :request
   :id :sbom-tool/user-runs-cli
   :from :sbom-tool/user
   :to :sbom-tool/cli
   :name "Runs"
   :tech "CLI"}

  {:el :request
   :id :sbom-tool/ci-pipeline-invokes-cli
   :from :sbom-tool/ci-pipeline
   :to :sbom-tool/cli
   :name "Invokes"
   :tech "CLI"}
  ;
  }
