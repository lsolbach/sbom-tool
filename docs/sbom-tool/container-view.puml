@startuml container-view
!include <C4/C4_Container.puml>
!include <awslib14/AWSCommon>
!include <awslib14/AWSC4Integration>
!include <azure/AzureCommon>
!include <azure/AzureC4Integration>
!include <tupadr3/common>
!include <tupadr3/devicons/clojure>
title Container View for the SBOM Tool
System_Ext(sbomTool_githubAdvisory, "GitHub Advisory Database", $descr="GitHub's advisory database, queried through the GitHub REST API.")
System_Ext(sbomTool_depsDev, "deps.dev", $descr="Google's open source insights service (deps.dev), queried by purl for vulnerability data.")
System_Ext(sbomTool_ciPipeline, "CI/CD Pipeline", $descr="Automated pipeline that invokes the SBOM Tool to gate builds on compliance policy violations.")
System_Ext(sbomTool_osv, "OSV", $descr="Google's open source vulnerability database (osv.dev), queried by purl.")
Person(sbomTool_user, "User", $descr="Runs the SBOM Tool CLI to check license and vulnerability compliance of software components.")
System_Boundary(sbomTool_sbomTool, "SBOM Tool") {
  Container(sbomTool_cli, "SBOM Tool CLI", $descr="Command-line application that reads SBOM files and reports license and vulnerability compliance.", $techn="Clojure", $sprite="clojure")
}
Rel(sbomTool_cli, sbomTool_githubAdvisory, "Looks up vulnerabilities (opt-in)", $techn="HTTPS/JSON")
Rel(sbomTool_cli, sbomTool_depsDev, "Looks up vulnerabilities (opt-in)", $techn="HTTPS/JSON")
Rel(sbomTool_cli, sbomTool_osv, "Looks up vulnerabilities (opt-in)", $techn="HTTPS/JSON")
Rel(sbomTool_user, sbomTool_cli, "Runs", $techn="CLI")
Rel(sbomTool_ciPipeline, sbomTool_cli, "Invokes", $techn="CLI")
SHOW_LEGEND()
@enduml

